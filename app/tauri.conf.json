{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper Rotator",
  "version": "0.3.2",
  "identifier": "dev.dflippojr.wallpaper-rotator",
  "build": {
    "frontendDist": [
      "../ui/index.html",
      "../ui/app.js",
      "../ui/style.css"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wallpaper Rotator",
        "width": 340,
        "height": 452,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://images.unsplash.com https://plus.unsplash.com https://images.pexels.com https://th.wallhaven.cc https://www.bing.com https://thumb.wikimedia.org https://upload.wikimedia.org; style-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Rotates Unsplash wallpapers with a bounded cache",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
